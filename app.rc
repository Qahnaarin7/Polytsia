#include <winver.h>
#include "version.h"

1 ICON "app.ico"
1 24 "app.manifest"

1 VERSIONINFO
 FILEVERSION POLYTSIA_VERSION_MAJOR,POLYTSIA_VERSION_MINOR,POLYTSIA_VERSION_PATCH,0
 PRODUCTVERSION POLYTSIA_VERSION_MAJOR,POLYTSIA_VERSION_MINOR,POLYTSIA_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Polytsia Shortcut Launcher"
            VALUE "FileVersion", POLYTSIA_VERSION_STRING
            VALUE "ProductName", "Polytsia"
            VALUE "ProductVersion", POLYTSIA_VERSION_STRING
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
