#include <winver.h>

1 ICON "app.ico"
1 24 "app.manifest"

1 VERSIONINFO
 FILEVERSION 1,2,13,0
 PRODUCTVERSION 1,2,13,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Polytsia Shortcut Launcher\0"
            VALUE "FileVersion", "1.2.13.0\0"
            VALUE "ProductName", "Polytsia\0"
            VALUE "ProductVersion", "1.2.13.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
